
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #fff5e6;
    color: #593719;
}


header {
    background-color: #8b4513;
    color: white;
    text-align: center;
    padding: 30px;
}

header h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

nav {
    background-color: #d9a441;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
    font-weight: bold;
}

nav a:hover {
    color: #593719;

section {
    padding: 40px 20px;
    text-align: center;
}

section h2 {
    margin-bottom: 20px;
    color: #8b4513;
}
.produk {
    background-color: white;
    margin: 15px auto;
    padding: 25px;
    max-width: 300px;
    border-radius: 12px;
    box-shadow: 0 3px 8px #cccccc;
}

.produk h3 {
    color: #8b4513;
    margin-bottom: 10px;
}

footer {
    background-color: #8b4513;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Tampilan HP */
@media (max-width: 600px) {
    nav a {
        display: inline-block;
        margin: 8px;
    }

    header h1 {
        font-size: 25px;
    }
}
